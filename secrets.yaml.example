wifi_ssid: "il-tuo-ssid"
wifi_password: "la-tua-password"

# Broker MQTT (Mosquitto) verso cui pubblicare le letture.
# L'indirizzo è quello del broker, NON quello di Home Assistant (coincidono
# solo se usi l'add-on Mosquitto sulla stessa macchina di HA).
mqtt_broker: "192.168.1.x"
mqtt_username: "esphome"
mqtt_password: "la-password-mqtt"
